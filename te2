defs.Add(new[] { @"PD C Slot N Out", @"P5D\4 Tenor C", @"0.0%", @"VAR _dr = [PD Snap]
VAR _dir = [PD Dir]
VAR _rt = VALUES ( 'P6W Rating Map'[Rating_ssj] )
VAR _noRt = NOT ISFILTERED ( 'P6W Rating Map' )
VAR _it = VALUES ( 'P6W Issuer Map'[IssuerId] )
VAR _noIt = NOT ISFILTERED ( 'P6W Issuer Map' )
VAR _p =
    CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( FACT_ALLREPO, FACT_ALLREPO[StartDate], FACT_ALLREPO[MaturityDate] ),
            ""@n"", CALCULATE ( SUMX ( FACT_ALLREPO, ABS ( FACT_ALLREPO[CashAmount_EUR] ) ) ), ""@k"", CALCULATE ( DISTINCTCOUNT ( FACT_ALLREPO[CCCTradeKey] ) ) ),
        REMOVEFILTERS ( DIM_DATE ), FACT_ALLREPO[SnapshotDate] = _dr, FACT_ALLREPO[SLA_CateCode] = ""07L"", KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Repo"" ) || CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Back"" ) ) ), FILTER ( ALL ( FACT_ALLREPO[BuySell] ), _dir = ""Both"" || FACT_ALLREPO[BuySell] = IF ( _dir = ""17A"", ""B"", ""S"" ) ), KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[Rating_ssj] ), _noRt || FACT_ALLREPO[Rating_ssj] IN _rt ) ), KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[IssuerId] ), _noIt || FACT_ALLREPO[IssuerId] IN _it ) ) )
VAR _t =
    SELECTCOLUMNS ( _p,
        ""@d"",
            VAR _s = FACT_ALLREPO[StartDate]
            VAR _m = FACT_ALLREPO[MaturityDate]
            VAR _x = IF ( NOT ISBLANK ( _s ) && NOT ISBLANK ( _m ), INT ( _m - _s ) )
            RETURN
                SWITCH ( TRUE (),
                    ISBLANK ( _x ) || _m >= DATE ( 2099, 1, 1 ) || _x < 0, -1,
                    _x <= 1 || ( _x <= 3 && WEEKDAY ( _s, 2 ) = 5 ), 1,
                    _x ),
        ""@n0"", [@n], ""@k0"", [@k] )
VAR _g = GROUPBY ( _t, [@d], ""@n"", SUMX ( CURRENTGROUP (), [@n0] ), ""@k"", SUMX ( CURRENTGROUP (), [@k0] ) )
VAR _N = SUMX ( _g, [@n] )
VAR _K = SUMX ( _g, [@k] )
VAR _top = TOPN ( 5, FILTER ( _g, [@d] > 1 ), [@n], DESC, [@d], ASC )
VAR _rk = ADDCOLUMNS ( _top, ""@r"", RANKX ( _top, [@d], , ASC ) )
VAR _s = SELECTEDVALUE ( 'PD Tenor Slot'[Order] )
VAR _row = FILTER ( _rk, [@r] = _s - 1 )
VAR _v =
    SWITCH ( _s,
        1, SUMX ( FILTER ( _g, [@d] = 1 ), [@n] ),
        7, _N - SUMX ( FILTER ( _g, [@d] = 1 || [@d] = -1 ), [@n] ) - SUMX ( _top, [@n] ),
        8, SUMX ( FILTER ( _g, [@d] = -1 ), [@n] ),
        SUMX ( _row, [@n] ) )
RETURN IF ( _N > 0 && _v > 0, DIVIDE ( _v, _N ) )" });
