-- (client, issuer) pairs first, then two CPH lookups per pair. Issuer = IssuerId: PD-08b (15 Nov) matches it to a
-- counterparty id on EUR 2,756bn of EUR 2,768bn face.
VAR _dr = [PD Snap]
VAR _dir = [PD Dir]
VAR _pairs =
    CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( FACT_ALLREPO, FACT_ALLREPO[HeadOfficeSirisId], FACT_ALLREPO[IssuerId] ), ""@f"", CALCULATE ( SUM ( FACT_ALLREPO[NotionalBond_EUR] ) ) ),
        REMOVEFILTERS ( DIM_DATE ), FACT_ALLREPO[SnapshotDate] = _dr, FACT_ALLREPO[SLA_CateCode] = ""07L"", KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Repo"" ) || CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Back"" ) ) ), FACT_ALLREPO[BuySell] = ""S"" )
VAR _own =
    SUMX ( _pairs,
        VAR _c = FACT_ALLREPO[HeadOfficeSirisId]
        VAR _i = FACT_ALLREPO[IssuerId]
        VAR _f = [@f]
        VAR _cc = CALCULATE ( LOOKUPVALUE ( DIM_COUNTERPARTY[CPH_Id], DIM_COUNTERPARTY[HeadOfficeSirisId], _c ), REMOVEFILTERS ( DIM_COUNTERPARTY ) )
        VAR _ic = CALCULATE ( LOOKUPVALUE ( DIM_COUNTERPARTY[CPH_Id], DIM_COUNTERPARTY[HeadOfficeSirisId], _i ), REMOVEFILTERS ( DIM_COUNTERPARTY ) )
        RETURN IF ( _c = _i || ( LEN ( _cc ) > 0 && _cc = _ic ), _f ) )
VAR _all = SUMX ( _pairs, [@f] )
RETURN IF ( NOT ISBLANK ( _dr ) && _all > 0, DIVIDE ( COALESCE ( _own, 0 ), _all ) )" });
