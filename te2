defs.Add(new[] { @"PD D Util Sits", @"P5D\5 Accounts D", @"", @"VAR _show = NOT ISBLANK ( [PD D Notional] )
VAR _g = SELECTEDVALUE ( 'PD D Group'[Group] )
VAR _isSp = _g = ""Sponsored (FICC / DTCC)""
-- Sponsored rows only: where the limit use of the sponsored trades seems to sit. Rough test, per CPY: the RECONC 17A / 17B
-- utilisation (PD Lim Util) is compared with the CPY's repo cash WITH and WITHOUT its sponsored lines; the closer one wins.
-- Not exact (ALLREPO cash never reconciles to RECONC to the cent, P6A_CHECK_4); 6 Nov book-level check: outside the lines.
VAR _u = [PD Lim Util]
VAR _all = CALCULATE ( [PD Notional], REMOVEFILTERS ( 'PD D Group' ) )
VAR _ex = CALCULATE ( [PD Notional], REMOVEFILTERS ( 'PD D Group' ),
    KEEPFILTERS ( FILTER ( ALL ( FACT_ALLREPO[InstLabel] ), NOT CONTAINSSTRING ( FACT_ALLREPO[InstLabel], ""Sponsored"" ) ) ) )
RETURN
    IF ( _show && _isSp,
        IF ( NOT ISINSCOPE ( DIM_COUNTERPARTY[CPY Label] ), ""per client ▸"",
            VAR _x = COALESCE ( _ex, 0 )
            VAR _sp = _all - _x
            RETURN
                SWITCH ( TRUE (),
                    ISBLANK ( _u ) || _u = 0, ""FICC / DTCC · no client line"",
                    ABS ( _u - _x ) <= ABS ( _u - _all ), ""FICC / DTCC"",
                    -- ""client line"" only when the util really looks like cash WITH sponsored: within 25 % of it, and the
                    -- sponsored part is big enough to tell the two apart (>= 25 % of the client's repo). Else ""unclear"".
                    ABS ( _u - _all ) <= 0.25 * _all && _sp >= 0.25 * _all, ""client line?"",
                    ""unclear"" ) ) )" });
