int created = 0, updated = 0, same = 0;
var rep = new System.Text.StringBuilder();
foreach (var d in defs) {
    if (home.Measures.Contains(d[0])) {
        var m = home.Measures[d[0]];
        bool eq = m.Expression.Replace("\r", "").Trim() == d[3].Replace("\r", "").Trim()
                  && m.DisplayFolder == d[1] && (m.FormatString ?? "") == d[2];
        if (eq) { same++; continue; }
        if (!dryRun) { m.Expression = d[3]; m.DisplayFolder = d[1]; m.FormatString = d[2]; }
        updated++; rep.AppendLine((dryRun ? "WOULD UPDATE  " : "updated  ") + d[0]);
    } else {
        if (!dryRun) { var m = home.AddMeasure(d[0], d[3], d[1]); m.FormatString = d[2]; }
