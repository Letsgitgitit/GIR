DEFINE
    // ---- tree entities (LOC rows = the sponsor's own local lines, skipped) -------------------
    VAR _tree =
        DISTINCT(
            SELECTCOLUMNS(
                FILTER( SPONSOR_TREE, SPONSOR_TREE[Nature] <> "LOC" ),
                "TreeName", TRIM( SPONSOR_TREE[OperationalClient] ),
                "Nature", SPONSOR_TREE[Nature],
                "OpCountry", SPONSOR_TREE[OpCountry],
                "Commercial", SPONSOR_TREE[CommercialClient]
            )
        )
    VAR _treeK =
        ADDCOLUMNS(
            _tree,
            "RKey",
                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(
                    UPPER( [TreeName] ) & " ", " LIMITED ", " LTD " ),
                    ".", "" ), ",", "" ), "'", "" ), "-", "" ), " ", "" )
        )
    // ---- WAR DB entities ------------------------------------------------------------------------
    VAR _dim =
        ADDCOLUMNS(
            SELECTCOLUMNS(
                FILTER( ALL( DIM_COUNTERPARTY ), LEN( DIM_COUNTERPARTY[Name] ) > 0 ),
                "Id", DIM_COUNTERPARTY[HeadOfficeSirisId],
                "DimName", DIM_COUNTERPARTY[Name],
                "CPH_Id", DIM_COUNTERPARTY[CPH_Id],
                "CPH_Name", DIM_COUNTERPARTY[CPH_Name],
                "InCORTEX", DIM_COUNTERPARTY[InCORTEX]
            ),
            "Key",
                SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(
                    UPPER( TRIM( [DimName] ) ) & " ", " LIMITED ", " LTD " ),
                    ".", "" ), ",", "" ), "'", "" ), "-", "" ), " ", "" )
        )
    // ---- candidates + activity per candidate ------------------------------------------------------
    VAR _cand =
        GENERATEALL(
            _treeK,
            VAR k = [RKey]
            VAR p20 = LEFT( k, 20 )
            VAR p15 = LEFT( k, 15 )
            VAR exact = FILTER( _dim, [Key] = k )
            VAR nE = COUNTROWS( exact )
            VAR pref = FILTER( _dim, nE = 0 && LEN( k ) >= 20 && LEFT( [Key], 20 ) = p20 )
            VAR nP = COUNTROWS( pref )
            VAR cont = FILTER( _dim, nE = 0 && nP = 0 && LEN( k ) >= 15 && CONTAINSSTRING( [Key], p15 ) )
            VAR allC =
                UNION(
                    ADDCOLUMNS( exact, "Match", "1 exact" ),
                    ADDCOLUMNS( pref, "Match", "2 prefix20" ),
                    ADDCOLUMNS( cont, "Match", "3 contains15" )
                )
            RETURN
                ADDCOLUMNS(
                    TOPN( 5, allC, [InCORTEX], DESC, [Id], ASC ),
                    "Candidates", COUNTROWS( allC ),
                    "Deals",
                        VAR _rid = [Id]
                        RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid ),
                    "Deals2026",
                        VAR _rid = [Id]
                        RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid,
                                          FACT_SALES[DealDate] >= DATE( 2026, 1, 1 ) ),
                    "LastDeal",
                        VAR _rid = [Id]
                        RETURN CALCULATE( MAX( FACT_SALES[DealDate] ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid ),
                    "Last16A",
                        VAR _rid = [Id]
                        RETURN CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid,
                                          FACT_LIMIT_16A[Utilisation] > 0 ),
                    "Last06",
                        VAR _rid = [Id]
                        RETURN CALCULATE( MAX( FACT_LIMIT_06[SnapshotDate] ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid,
                                          FACT_LIMIT_06[Utilisation] > 0 ),
                    "LastRepo",   // [may error]
                        VAR _rid = [Id]
                        RETURN CALCULATE( MAX( FACT_ALLREPO[SnapshotDate] ), DIM_COUNTERPARTY[HeadOfficeSirisId] = _rid )
                )
        )

// ---- T1 candidates with activity --------------------------------------------------------------
EVALUATE
    SELECTCOLUMNS(
        _cand,
        "TreeName", [TreeName],
        "Nature", [Nature],
        "OpCountry", [OpCountry],
        "Match", [Match],
        "Candidates", [Candidates],
        "RICOS", [Id],
        "DimName", [DimName],
        "CPH_Id", [CPH_Id],
        "CPH_Name", [CPH_Name],
        "InCORTEX", [InCORTEX],
        "Deals", [Deals],
        "Deals2026", [Deals2026],
        "LastDeal", [LastDeal],
        "Last16A", [Last16A],
        "Last06", [Last06],
        "LastRepo", [LastRepo]
    )
    ORDER BY [TreeName], [Nature], [Match], [InCORTEX] DESC

// ---- T2 one row per tree entity (totals over the best-tier candidates only) ------------------
EVALUATE
    ADDCOLUMNS(
        ADDCOLUMNS(
            SELECTCOLUMNS( _treeK, "TreeName", [TreeName], "Nature", [Nature], "Commercial", [Commercial] ),
            "BestMatch",
                VAR _n = [TreeName] VAR _t = [Nature]
                RETURN MINX( FILTER( _cand, [TreeName] = _n && [Nature] = _t ), [Match] )
        ),
        "Candidates",
            VAR _n = [TreeName] VAR _t = [Nature]
            RETURN MAXX( FILTER( _cand, [TreeName] = _n && [Nature] = _t ), [Candidates] ),
        "RICOS",
            VAR _n = [TreeName] VAR _t = [Nature] VAR _b = [BestMatch]
            RETURN CONCATENATEX( FILTER( _cand, [TreeName] = _n && [Nature] = _t && [Match] = _b ), [Id], " | " ),
        "Deals",
            VAR _n = [TreeName] VAR _t = [Nature] VAR _b = [BestMatch]
            RETURN SUMX( FILTER( _cand, [TreeName] = _n && [Nature] = _t && [Match] = _b ), [Deals] ),
        "LastDeal",
            VAR _n = [TreeName] VAR _t = [Nature] VAR _b = [BestMatch]
            RETURN MAXX( FILTER( _cand, [TreeName] = _n && [Nature] = _t && [Match] = _b ), [LastDeal] ),
        "Last16A",
            VAR _n = [TreeName] VAR _t = [Nature] VAR _b = [BestMatch]
            RETURN MAXX( FILTER( _cand, [TreeName] = _n && [Nature] = _t && [Match] = _b ), [Last16A] ),
        "Last06",
            VAR _n = [TreeName] VAR _t = [Nature] VAR _b = [BestMatch]
            RETURN MAXX( FILTER( _cand, [TreeName] = _n && [Nature] = _t && [Match] = _b ), [Last06] )
    )
    ORDER BY [BestMatch], [Deals] DESC, [TreeName]

// ---- T3 tree CPH -> WAR DB CPH, activity of the whole CPH ----------------------------------------
EVALUATE
    VAR _cphDim =
        ADDCOLUMNS(
            FILTER(
                DISTINCT( SELECTCOLUMNS( _dim, "CPH_Id", [CPH_Id], "CPH_Name", [CPH_Name] ) ),
                LEN( [CPH_Id] ) > 0
            ),
            "CKey",
                VAR ck =
                    SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE( SUBSTITUTE(
                        UPPER( TRIM( [CPH_Name] ) ) & " ", " LIMITED ", " LTD " ),
                        ".", "" ), ",", "" ), "'", "" ), "-", "" ), " ", "" )
                RETURN IF( RIGHT( ck, 3 ) = "CPH" && LEN( ck ) > 3, LEFT( ck, LEN( ck ) - 3 ), ck )
        )
    RETURN
        GENERATEALL(
            SELECTCOLUMNS( FILTER( _treeK, [Nature] = "CPH" ), "TreeCPH", [TreeName], "RKey", [RKey] ),
            VAR k0 = [RKey]
            VAR k = IF( RIGHT( k0, 3 ) = "CPH" && LEN( k0 ) > 3, LEFT( k0, LEN( k0 ) - 3 ), k0 )
            RETURN
                ADDCOLUMNS(
                    SELECTCOLUMNS( FILTER( _cphDim, [CKey] = k ), "WarCPH_Id", [CPH_Id], "WarCPH_Name", [CPH_Name] ),
                    "CPYs",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( COUNTROWS( DIM_COUNTERPARTY ), DIM_COUNTERPARTY[CPH_Id] = _cph ),
                    "Deals",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[CPH_Id] = _cph ),
                    "Deals2026",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[CPH_Id] = _cph,
                                          FACT_SALES[DealDate] >= DATE( 2026, 1, 1 ) ),
                    "LastDeal",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( MAX( FACT_SALES[DealDate] ), DIM_COUNTERPARTY[CPH_Id] = _cph ),
                    "Last16A",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), DIM_COUNTERPARTY[CPH_Id] = _cph,
                                          FACT_LIMIT_16A[Utilisation] > 0 ),
                    "Last06",
                        VAR _cph = [WarCPH_Id]
                        RETURN CALCULATE( MAX( FACT_LIMIT_06[SnapshotDate] ), DIM_COUNTERPARTY[CPH_Id] = _cph,
                                          FACT_LIMIT_06[Utilisation] > 0 )
                )
        )
    ORDER BY [Deals] DESC, [TreeCPH]

// ---- T4 WAR DB CPHs reached by an exact entity match (the sponsor footprint) ----------------------
EVALUATE
    VAR _hits = FILTER( _cand, [Match] = "1 exact" && LEN( [CPH_Id] ) > 0 )
    VAR _cphs = DISTINCT( SELECTCOLUMNS( _hits, "WarCPH_Id", [CPH_Id], "WarCPH_Name", [CPH_Name] ) )
    RETURN
        ADDCOLUMNS(
            _cphs,
            "TreeEntitiesMatched",
                VAR _c = [WarCPH_Id]
                RETURN COUNTROWS( DISTINCT( SELECTCOLUMNS( FILTER( _hits, [CPH_Id] = _c ), "n", [TreeName] ) ) ),
            "CPYsInWarDB",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( COUNTROWS( DIM_COUNTERPARTY ), DIM_COUNTERPARTY[CPH_Id] = _c ),
            "Deals",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[CPH_Id] = _c ),
            "Deals2026",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( COUNTROWS( FACT_SALES ), DIM_COUNTERPARTY[CPH_Id] = _c,
                                  FACT_SALES[DealDate] >= DATE( 2026, 1, 1 ) ),
            "LastDeal",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( MAX( FACT_SALES[DealDate] ), DIM_COUNTERPARTY[CPH_Id] = _c ),
            "Last16A",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( MAX( FACT_LIMIT_16A[SnapshotDate] ), DIM_COUNTERPARTY[CPH_Id] = _c,
                                  FACT_LIMIT_16A[Utilisation] > 0 ),
            "Last06",
                VAR _c = [WarCPH_Id]
                RETURN CALCULATE( MAX( FACT_LIMIT_06[SnapshotDate] ), DIM_COUNTERPARTY[CPH_Id] = _c,
                                  FACT_LIMIT_06[Utilisation] > 0 )
        )
    ORDER BY [Deals] DESC, [WarCPH_Name]
