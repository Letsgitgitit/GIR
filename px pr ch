// =====================================================================================
// P6W_SETUP_PATCH_08.dax  -  BUILD 2026-11-18f  -  PX bond-price table: flag threshold (S1, 18d) + side slicer (S2, 18f)
// Run BEFORE P6A_MEASURES_TE2.csx build 2026-11-18f (S1 already in? paste S2 only) (the script stops if this table is missing).
// HOW: Modeling ▸ New table ▸ paste the block (name included) ▸ Enter. No relationship.
// Then: Points ▸ Column tools ▸ Format ▸ Decimal, 1 decimal place. Sort Label by Order; hide Order.
// The values are only choices offered on the slicer: pick the default on the page (save the page with it selected).
// =====================================================================================

// ---- S1 threshold in price points: booked price vs market price (median of all clients' rows), or a booked jump the
//      market price did not make.
PX Price Threshold =
DATATABLE (
    "Label", STRING, "Points", DOUBLE, "Order", INTEGER,
    { { "0.25 pt", 0.25, 1 }, { "0.5 pt", 0.5, 2 }, { "1 pt", 1, 3 }, { "2 pt", 2, 4 }, { "5 pt", 5, 5 } }
)

// ---- S2 (18f) side slicer for the bond-price visuals (PX6, PX7, PX TT Price). Sort Side by Order; hide Order.
//      17A = repo (BuySell B, bonds we delivered) · 17B = reverse repo (BuySell S, bonds we hold as collateral).
PX Side =
DATATABLE ( "Side", STRING, "Order", INTEGER, { { "Both", 1 }, { "17A", 2 }, { "17B", 3 } } )
